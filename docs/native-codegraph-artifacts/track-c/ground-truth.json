      "evidence": ["src/orders.ts:export async function createOrder", "src/orders.ts:await persistOrder(order)", "src/persistence.ts:export async function persistOrder", "src/persistence.ts:await writeRecord(\"orders\", order.id, order)", "src/storage.ts:export async function writeRecord"]
