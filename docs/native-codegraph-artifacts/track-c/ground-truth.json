{
  "schemaVersion": 1,
  "frozenBeforeCandidateRuns": true,
  "corpus": "fixtures",
  "languageClaims": ["TypeScript", "Python"],
  "limitations": [
    "Symbol and edge expectations are based on explicit declarations, imports, and direct calls in these fixture files; dynamic dispatch and runtime behavior are not expected.",
